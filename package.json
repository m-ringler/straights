{
  "name": "straights",
  "private": true,
  "version": "0.9.2",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/serviceworker": "^0.0.203",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cheerio": "^1.2.0",
    "jquery": "^4.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 80
  },
  "scripts": {
    "format": "prettier --write \"webdev/**/*.js\" \"**/*.{ts,css,html,json}\"",
    "tsc": "tsc -p tsconfig.json",
    "tsc:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:debug": "vitest --inspect-brk --no-coverage"
  }
